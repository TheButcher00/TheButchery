    key.position.x  = Math.sin(t * .35) * 2.5;
    rim.intensity   = 4.2  + Math.sin(t * 2.2) * .7;
    ember.intensity = 3.0  + Math.sin(t * 1.3) * .5;
    flkr.intensity  = 1.9  + Math.sin(t * 8.1) * .9;

    chainObjs.forEach(({ g, cfg }) => {
      const sway = Math.sin(t * cfg.swS + cfg.ph) * cfg.sw;
      const tx2 = cfg.f + sway + mx * .14 * (cfg.z > 0 ? 2.2 : .65);
      g.position.x += (tx2 - g.position.x) * .014;
      g.position.y = 17 - scrollY * (cfg.z > 2 ? .006 : cfg.z > -2 ? .004 : .0025);
      g.rotation.z = sway * .032;
      g.children.forEach((l, i) => { const w = Math.sin(t * 1.15 + i * .4 + cfg.ph) * .012; l.rotation.z += (w - l.rotation.z) * .08; });
    });

    if (frame % 210 === 0 && Math.random() < .65) spawnBlood(COLS[Math.floor(Math.random() * COLS.length)]);

    for (let i = drops.length - 1; i >= 0; i--) {
      const d = drops[i];
      d.userData.vy -= d.userData.grav; d.position.y += d.userData.vy;
      d.userData.life -= d.userData.decay; d.material.opacity = Math.max(0, d.userData.life);
      if (d.userData.life <= 0) { scene.remove(d); d.geometry.dispose(); d.material.dispose(); drops.splice(i, 1); }
    }

    renderer.render(scene, cam);
  }
  animate();
})();

/* ─── SECTION CHAIN RULES (2D Canvas) ─── */
function drawChainRule(id) {
  const el = document.getElementById(id);
  if (!el) return;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const W = el.offsetWidth || 1100, H = 44;
  el.width = W * dpr; el.height = H * dpr;
  el.style.width = W + 'px'; el.style.height = H + 'px';
  const ctx = el.getContext('2d');
  ctx.scale(dpr, dpr);
  const cy = H / 2, LW = 22, LH = 13, PITCH = 23;
  const n = Math.ceil(W / PITCH) + 2;
  const lg = ctx.createLinearGradient(0, 0, W, 0);
  lg.addColorStop(0, 'rgba(90,0,0,0)'); lg.addColorStop(.12, 'rgba(90,0,0,.5)');
  lg.addColorStop(.5, 'rgba(139,0,0,.2)'); lg.addColorStop(.88, 'rgba(90,0,0,.5)'); lg.addColorStop(1, 'rgba(90,0,0,0)');
  ctx.beginPath(); ctx.moveTo(0, cy); ctx.lineTo(W, cy);
  ctx.strokeStyle = lg; ctx.lineWidth = 1; ctx.stroke();

  for (let i = 0; i < n; i++) {
    const cx = 3 + i * PITCH, horiz = i % 2 === 0;
    const lw = horiz ? LW : LH, lh = horiz ? LH : LW;
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,.95)'; ctx.shadowBlur = 6; ctx.shadowOffsetX = 1.5; ctx.shadowOffsetY = 2.5;
    const bg = ctx.createLinearGradient(cx - lw/2, cy - lh/2, cx + lw/2, cy + lh/2);
    bg.addColorStop(0, 'rgba(72,50,50,.95)'); bg.addColorStop(.2, 'rgba(58,40,40,.95)');
    bg.addColorStop(.48, 'rgba(20,10,10,.95)'); bg.addColorStop(.75, 'rgba(44,30,30,.95)'); bg.addColorStop(1, 'rgba(28,16,16,.92)');
    ctx.beginPath(); ctx.ellipse(cx, cy, lw/2, lh/2, 0, 0, Math.PI * 2);
    ctx.fillStyle = bg; ctx.fill();
    ctx.strokeStyle = 'rgba(88,58,58,.88)'; ctx.lineWidth = 1.6; ctx.stroke(); ctx.restore();
    ctx.save();
    ctx.beginPath(); ctx.ellipse(cx, cy, lw/2*.43, lh/2*.43, 0, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(2,0,0,.98)'; ctx.fill(); ctx.restore();
    ctx.save();
    ctx.beginPath(); ctx.ellipse(cx - lw*.14, cy - lh*.18, lw*.1, lh*.08, -.3, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(210,170,140,.16)'; ctx.fill(); ctx.restore();
    if (i % 3 === 0) {
      const dh = 8 + Math.random() * 14;
      ctx.save();
      const dg = ctx.createLinearGradient(cx, cy + lh/2, cx, cy + lh/2 + dh);
      dg.addColorStop(0, 'rgba(100,0,0,.58)'); dg.addColorStop(1, 'rgba(50,0,0,0)');
      ctx.beginPath();
      ctx.moveTo(cx - 1.5, cy + lh/2);
      ctx.quadraticCurveTo(cx + 2.2, cy + lh/2 + dh * .6, cx, cy + lh/2 + dh);
      ctx.quadraticCurveTo(cx - 2.2, cy + lh/2 + dh * .6, cx - 1.5, cy + lh/2);
      ctx.fillStyle = dg; ctx.fill(); ctx.restore();
    }
  }
}
['cr1', 'cr2', 'cr3', 'cr4', 'cr5'].forEach(drawChainRule);

